---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
  </header>

  <style>
    .cv-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .cv-col-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--global-text-color);
      border-bottom: 1px solid var(--global-divider-color);
      padding-bottom: 0.6rem;
      margin-bottom: 1.2rem;
    }
    .cv-col-header::before {
      content: "●";
      color: var(--global-theme-color);
      font-size: 0.9rem;
    }
    .cv-timeline {
      border-left: 1px solid var(--global-divider-color);
      padding-left: 1.2rem;
    }
    .cv-timeline-item {
      position: relative;
      margin-bottom: 1.6rem;
    }
    .cv-timeline-item::before {
      content: "";
      position: absolute;
      left: -1.55rem;
      top: 0.45rem;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid var(--global-divider-color);
      background: var(--global-bg-color);
    }
    .cv-year {
      color: var(--global-theme-color);
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 0.15rem;
      letter-spacing: 0.02em;
    }
    .cv-role {
      font-weight: 700;
      font-size: 0.97rem;
      color: var(--global-text-color);
      margin-bottom: 0.1rem;
    }
    .cv-place {
      font-size: 0.88rem;
      color: var(--global-text-color);
      margin-bottom: 0.25rem;
    }
    .cv-desc {
      font-size: 0.83rem;
      color: var(--global-text-color-light);
      line-height: 1.5;
    }
    @media (max-width: 768px) {
      .cv-two-col { grid-template-columns: 1fr; }
    }
  </style>

  <article>
    <div class="cv">

      <!-- Experience & Education two-column block -->
      <div class="card mt-3 p-3">
        <h3 class="card-title font-weight-medium">Experience &amp; Education</h3>
        <div class="cv-two-col mt-3">

          <!-- Left: Professional Experience -->
          <div>
            <div class="cv-col-header">Professional Experience</div>
            <div class="cv-timeline">
              <div class="cv-timeline-item">
                <div class="cv-year">2024 - Current</div>
                <div class="cv-role">Research Scientist</div>
                <div class="cv-place">Accenture</div>
                <div class="cv-desc">LLM &amp; multi-agent systems research.</div>
              </div>
              <div class="cv-timeline-item">
                <div class="cv-year">May - Aug 2023</div>
                <div class="cv-role">Research Intern</div>
                <div class="cv-place">United Imaging Intelligence, Cambridge, MA</div>
                <div class="cv-desc">3D computer vision and neural rendering with Dr. Benjamin Planche and Dr. Ziyan Wu.</div>
              </div>
            </div>
          </div>

          <!-- Right: Education -->
          <div>
            <div class="cv-col-header">Education</div>
            <div class="cv-timeline">
              <div class="cv-timeline-item">
                <div class="cv-year">2021 - 2024</div>
                <div class="cv-role">Ph.D. in Electrical and Computer Engineering</div>
                <div class="cv-place">Vanderbilt University, Nashville, TN</div>
                <div class="cv-desc">Advisor: Prof. Jack Noble</div>
              </div>
              <div class="cv-timeline-item">
                <div class="cv-year">2017 - 2019</div>
                <div class="cv-role">M.S. in Electrical Engineering</div>
                <div class="cv-place">George Washington University, Washington, DC</div>
              </div>
              <div class="cv-timeline-item">
                <div class="cv-year">2013 - 2017</div>
                <div class="cv-role">B.Eng. in Energy and Power Engineering</div>
                <div class="cv-place">Wuhan University of Technology, Wuhan, China</div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </article>
</div>
