@inproceedings{li2026unebolt,
  title={UnEBOLT: A Unified Model for EEG-to-BOLD Translation and Functional Connectivity Reconstruction},
  author={Yamin Li and Ange Lou and Chang Li and Shiyu Wang and Haatef Pourmotabbed and Ziyuan Xu and Shengchao Zhang and Dario J. Englot and Soheil Kolouri and Daniel Moyer and Roza G. Bayrak and Catie Chang},
  booktitle={Medical Imaging with Deep Learning},
  year={2026},
  abbr={MIDL 2026},
  selected={true},
  html={https://openreview.net/forum?id=H2xZBbsYv4},
  preview={midl26_unebolt.png},
  abstract={We propose UnEBOLT, a unified end-to-end framework for whole-brain EEG-to-fMRI translation. By combining a multi-dimensional EEG encoder with a Gated Adaptive Fusion module and ROI-specific representation learning, UnEBOLT reconstructs fMRI BOLD signals and functional connectivity across all brain regions in a single model, without region-specific training.},
}

@misc{lou2026irsis,
  title={VLM-Guided Iterative Refinement for Surgical Image Segmentation with Foundation Models},
  author={Ange Lou and Yamin Li and Qi Chang and Nan Xi and Luyuan Xie and Zichao Li and Tianyu Luan},
  year={2026},
  eprint={2602.09252},
  archivePrefix={arXiv},
  primaryClass={cs.CV},
  abbr={arXiv},
  booktitle={arXiv preprint},
  selected={true},
  arxiv={2602.09252},
  preview={icml26_irsis.png},
  abstract={We propose IR-SIS, an iterative refinement system for surgical image segmentation driven by natural language. IR-SIS combines a fine-tuned SAM3 for initial segmentation with a Vision-Language Model that detects errors and generates corrective prompts, enabling clinician-in-the-loop interaction and adaptive refinement without retraining.},
}

@misc{rezazadeh2025collaborative,
  title={Collaborative Memory: Multi-User Memory Sharing in LLM Agents with Dynamic Access Control},
  author={Alireza Rezazadeh and Zichao Li and Ange Lou and Yuying Zhao and Wei Wei and Yujia Bao},
  year={2025},
  eprint={2505.18279},
  archivePrefix={arXiv},
  primaryClass={cs.AI},
  abbr={ICML 2025},
  booktitle={ICML 2025 Multi-Agent Systems Workshop},
  selected={true},
  arxiv={2505.18279},
  preview={icml25_mas.png},
  abstract={We introduce Collaborative Memory, a framework for multi-user, multi-agent LLM environments with asymmetric, time-evolving access controls encoded as bipartite graphs. The system maintains private and shared memory tiers, with granular read/write policies that enforce user-agent-resource constraints and enable safe, auditable cross-user knowledge sharing.},
}

@misc{li2024neurobolt,
  title={NeuroBOLT: Resting-state EEG-to-fMRI Synthesis with Multi-dimensional Feature Mapping},
  author={Yamin Li and Ange Lou and Ziyuan Xu and Shengchao Zhang and Shiyu Wang and Dario J. Englot and Soheil Kolouri and Daniel Moyer and Roza G. Bayrak and Catie Chang},
  year={2024},
  eprint={2410.05341},
  archivePrefix={arXiv},
  primaryClass={eess.IV},
  abbr={NeurIPS 2024},
  booktitle={Advances in Neural Information Processing Systems},
  selected={true},
  arxiv={2410.05341},
  website={https://soupeeli.github.io/NeuroBOLT/},
  code={https://github.com/soupeeli/NeuroBOLT},
  poster={https://neurips.cc/media/PosterPDFs/NeurIPS%202024/93044.png?t=1733617950.057914},
  preview={teaser_nips.gif},
  abstract={We present NeuroBOLT, a framework for synthesizing resting-state fMRI BOLD signals from EEG recordings using multi-dimensional feature mapping. Our approach leverages the temporal resolution of EEG and the spatial richness of fMRI to bridge neuroscientific modalities, enabling large-scale brain connectivity studies without simultaneous EEG-fMRI acquisition.},
}

@misc{lou2024zeroshotsurgical,
  title={Zero-Shot Surgical Tool Segmentation in Monocular Video Using Segment Anything Model 2},
