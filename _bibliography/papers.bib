@article{lou2023minmax,
  title={Min-Max Similarity: A Contrastive Semi-Supervised Deep Learning Network for Surgical Tools Segmentation},
  author={Ange Lou and Kareem Tawfik and Xing Yao and Ziteng Liu and Jack Noble},
  journal={IEEE Transactions on Medical Imaging},
  year={2023},
  publisher={IEEE},
  abbr={IEEE-TMI},
