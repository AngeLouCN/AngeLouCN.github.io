  preview={min_max.jpg},
  abstract={We propose a contrastive semi-supervised learning framework for surgical tool segmentation that leverages both labeled and unlabeled endoscopic images. The Min-Max similarity loss enforces consistency between augmented views while maximizing inter-class separation, significantly reducing annotation cost without sacrificing segmentation accuracy.},
}

