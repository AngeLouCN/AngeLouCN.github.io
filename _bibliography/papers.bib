  year={2025},
  eprint={2408.01648},
  archivePrefix={arXiv},
  primaryClass={cs.CV},
  abbr={SPIE:MI 2025},
  booktitle={SPIE Medical Imaging},
  selected={true},
  arxiv={2408.01648},
  preview={endovis17_3.gif},
